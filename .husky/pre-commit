# Conflict markers first, ahead of lint-staged: prettier rewrites a closing marker in markdown into
# a nested blockquote, which then reads as intentional (issue #113). Catch it in its raw shape.
node scripts/check-conflict-markers.mjs --staged

# ADR numbers must be unique (issue #151). Cheap and whole-directory, so it runs unconditionally —
# the failure mode is two branches each taking "the next number", which only shows up on the second
# merge. The contract test is the real gate; this is the fast one that tells you before you push.
node scripts/check-adr-numbers.mjs

pnpm exec lint-staged
# Affected-only type-check, but fall back to a full run when there's no parent
# commit to diff against (initial commit / fresh clone).
if git rev-parse --verify -q HEAD^1 >/dev/null 2>&1; then
  pnpm turbo run type-check --filter="...[HEAD^1]"
else
  pnpm turbo run type-check
fi
