# ADR numbering first, and *unconditionally* — the affected-only run below cannot see it.
# An ADR is a docs-only change, so it touches no package, so `--filter="...[HEAD^1]"` selects
# nothing and zero tests run on the one push that can introduce a number collision. That hole plus
# `CI_ENABLED=false` (the Actions billing block, which skips the `test:unit` leg that is the only
# other place this runs) is how three collisions shipped: #151, then 0075/0076, then #316. It also
# checks against `origin/main`, which no single-branch gate can — see scripts/check-adr-numbers.mjs
# and issue #317. Pass --local to skip only the origin/main half when you're offline.
node scripts/check-adr-numbers.mjs || exit 1

# Affected-only tests, falling back to a full run when there's no parent commit
# to diff against (e.g. pushing the very first commit).
if git rev-parse --verify -q HEAD^1 >/dev/null 2>&1; then
  pnpm turbo run test:contracts test:unit --filter="...[HEAD^1]"
else
  pnpm turbo run test:contracts test:unit
fi

# Review agents are NOT run here — they fire 4-6 real Claude Code sessions and add
# 1-2 min to every push. Run them on demand instead, right before opening a PR:
#   pnpm run review           # this branch vs origin/main
#   pnpm run review --ci      # exit non-zero on blocking findings
# See review-agents/README.md.
