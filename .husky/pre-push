# Affected-only tests, falling back to a full run when there's no parent commit
# to diff against (e.g. pushing the very first commit).
if git rev-parse --verify -q HEAD^1 >/dev/null 2>&1; then
  pnpm turbo run test:contracts test:unit --filter="...[HEAD^1]"
else
  pnpm turbo run test:contracts test:unit
fi
