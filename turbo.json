{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    // FFMPEG_PATH/FFPROBE_PATH are declared on the local-facing test tasks for the same reason as on
    // test:integration below: strict env mode strips them otherwise, so a workstation that keeps
    // ffmpeg off PATH and points at it by variable — the arrangement the desktop app uses — silently
    // skipped every real-binary test at pre-push, which is the same blind spot in miniature.
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "MARQUEE_REQUIRE_FFMPEG",
        "FFMPEG_PATH",
        "FFPROBE_PATH",
        "VITEST_MAX_FORKS",
        "VITEST_MIN_FORKS"
      ]
    },
    // VITEST_MAX_FORKS/VITEST_MIN_FORKS cap vitest's fork pool on the Windows CI leg — the second
    // half of the mitigation for the #131/#156 flakes, which ci.yml sets and explains. They were
    // undeclared here for the whole of their life, so strict env mode stripped them and the cap
    // never applied (issue #223); the leg ran the default CPU-count pool while the comment said
    // otherwise. Declared on `test` too, because that task runs the same vitest invocation.
    // workflow-turbo-env.test.ts now fails if a workflow sets a variable nothing here declares.
    "test:unit": {
      "dependsOn": ["^build"],
      "env": [
        "MARQUEE_REQUIRE_FFMPEG",
        "FFMPEG_PATH",
        "FFPROBE_PATH",
        "VITEST_MAX_FORKS",
        "VITEST_MIN_FORKS"
      ]
    },
    "test:contracts": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      // turbo runs in strict env mode, so a variable the workflow sets but nobody declares here is
      // stripped before vitest ever sees it. MARQUEE_REQUIRE_FFMPEG is what makes a missing ffmpeg
      // fail the build instead of skipping quietly (see test/ffmpeg-gate.ts), so an undeclared one
      // would restore the exact silence this task exists to end. FFMPEG_PATH/FFPROBE_PATH are here
      // for the same reason: they're how a machine without ffmpeg on PATH points at its binaries.
      "env": ["MARQUEE_REQUIRE_FFMPEG", "FFMPEG_PATH", "FFPROBE_PATH"]
    }
  }
}
