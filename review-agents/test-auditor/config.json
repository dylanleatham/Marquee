{
  "id": "test-auditor",
  "blocking": true,
  "model": "sonnet",
  "timeoutMs": 180000,
  "triggerGlobs": [
    "packages/**/src/**",
    "packages/stylus/stylus/**",
    "review-agents/*.mjs",
    "review-agents/lib/*.mjs",
    "review-agents/eval/*.mjs",
    "scripts/**/*.mjs",
    "contract-tests/**/*.mjs",
    "e2e/**/*.mjs"
  ],
  "contextGlobs": ["docs/specs/testing-strategy.md"]
}
