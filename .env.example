# Marquee — environment variables for DEV and CI only.
# Runtime services on real hardware read secrets from local config.toml files, NOT env vars.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Spotify Web API (used by Curator/Roadie for metadata + art) ---
# Create an app at https://developer.spotify.com/dashboard
# You can reuse the credentials from your existing Conflicted Lineup app.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# --- Service-to-service shared secret (sent as X-Trigger-Secret header) ---
# LAN-only "prevent accidents" secret. Generate one: `openssl rand -hex 16`
# The SAME value must be set in each device's config.toml (Conductor, Backdrop, Stylus).
TRIGGER_SHARED_SECRET=change-me-lan-only-secret

# --- Runtime service URLs (used by Curator to push updates + simulate scans) ---
# Setting CONDUCTOR_URL also turns ON the album-assets push (ADR 0045) — Curator sends the store to
# Conductor's ingest API instead of you running rsync, and Amp reads the same directory. Leaving it
# unset keeps the localhost default for the Demo Room proxy with the push off, so a workstation with
# no runtime doesn't collect an "unreachable" syncIssue on every album.
CONDUCTOR_URL=http://conductor.local:4737
BACKDROP_URL=http://backdrop.local:4740
# Force the push on or off independently of the URL (e.g. a co-located Conductor in the desktop app).
# CURATOR_CONDUCTOR_PUSH_ASSETS=true

# --- Turbo remote cache (optional; used in CI) ---
TURBO_TOKEN=
TURBO_TEAM=

# --- Review agents (dev-harness §6) ---
# Path to the Claude Code binary the review orchestrator shells out to.
# Defaults to `claude` on PATH. Auth is handled by `claude login` (no API key here).
CLAUDE_CODE_PATH=claude

# --- Data locations (dev overrides; default is ~/marquee) ---
# MARQUEE_DATA_DIR=./marquee-data
