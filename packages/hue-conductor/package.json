{
  "name": "@marquee/hue-conductor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drives Hue lights from palette+pattern payloads. Headless service on the Pi 5.",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pair": "tsx src/pair.ts",
    "build": "tsc -b",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "echo \"(no linter configured yet)\""
  },
  "dependencies": {
    "@marquee/contracts": "workspace:*",
    "fastify": "^5.1.0",
    "node-hue-api": "^4.0.11",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  }
}
