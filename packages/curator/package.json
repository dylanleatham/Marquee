{
  "name": "@marquee/curator",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Admin app + source of truth for the collection. Hosts Roadie. Runs on your workstation.",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ui": "vite ui",
    "app": "pnpm build && node dist/server.js --open",
    "start": "node dist/server.js",
    "build": "tsc -b && vite build ui",
    "build:ui": "vite build ui",
    "favicon": "node scripts/make-favicon.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run video-ffmpeg-integration card-art-print",
    "lint": "echo \"(no linter configured yet)\""
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8",
    "@marquee/contracts": "workspace:*",
    "@marquee/observability": "workspace:*",
    "@marquee/palette-press": "workspace:*",
    "fastify": "^5.12.5",
    "nanoid": "^5.0.7",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@marquee/fake-discogs": "workspace:*",
    "@marquee/fake-gemini": "workspace:*",
    "@marquee/fake-spotify": "workspace:*",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^30",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5",
    "vitest": "^2.1.3",
    "yaml": "^2"
  }
}
