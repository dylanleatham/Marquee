{
  "name": "@marquee/curator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Admin app + source of truth for the collection. Hosts Roadie. Runs on your workstation.",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ui": "vite ui",
    "start": "node dist/server.js",
    "build": "tsc -b && vite build ui",
    "build:ui": "vite build ui",
    "type-check": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "echo \"(no linter configured yet)\""
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8",
    "@marquee/contracts": "workspace:*",
    "@marquee/palette-press": "workspace:*",
    "fastify": "^5.1.0",
    "nanoid": "^5.0.7",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@marquee/fake-spotify": "workspace:*",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^22.7.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5",
    "vitest": "^2.1.3"
  }
}
