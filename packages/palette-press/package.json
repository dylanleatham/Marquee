{
  "name": "@marquee/palette-press",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Presses a Hue-safe palette out of album art. Pure library, no I/O.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "update-goldens": "cross-env UPDATE_GOLDENS=1 vitest run golden",
    "lint": "echo \"(no linter configured yet)\""
  },
  "dependencies": {
    "@marquee/contracts": "workspace:*",
    "node-vibrant": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "cross-env": "^7.0.3",
    "fast-check": "^4.10.2",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  }
}
