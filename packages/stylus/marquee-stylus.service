[Unit]
Description=Marquee Stylus — NFC sleeve reader
Documentation=https://github.com/dylanleatham/Marquee/blob/main/packages/stylus/DEPLOY.md
# stylus-spec §12: the Pi Zero 2 W regularly finishes booting before Wi-Fi is up. Without
# network-online the first POSTs after every reboot fail against an unroutable LAN.
After=network-online.target
Wants=network-online.target
# Don't give up after the default 5-starts-in-10s: a PN532 that needs a few power-cycle attempts, or
# a boot where the I2C bus isn't ready yet, would otherwise leave the stand dead until you SSH in.
# (Belongs in [Unit], not [Service] — systemd 229+ moved it, and it's silently ignored in [Service].)
StartLimitIntervalSec=0

[Service]
# stylus-spec §12 "PN532 hangs" / #308: `notify` (not `simple`) so the poll loop can prove it's
# still executing. Stylus sends READY=1 once the reader is up and the status port is listening;
# without that the unit sits in `activating` and is killed at TimeoutStartSec.
Type=notify

# The other half of the hang story. `Restart=always` recovers a process that *dies*; a poll loop
# blocked inside a driver call never does, and the unit stays `active (running)` with a silent
# journal, reading nothing. WATCHDOG=1 stops arriving and systemd kills us, which Restart= then
# recovers — the same trick #307 plays for the one-time init, applied to the loop.
#
# Why 30 and not less: Stylus pings at WatchdogSec/2 = 15s, so the *longest gap between heartbeat
# calls* must stay under 15s or a healthy service gets killed. Since #173 the only beat is the one
# at the top of each poll tick, and publishing happens on a worker thread, so that gap is one poll
# interval (200ms) plus the reader's own work — comfortably under a second. Downstream `timeout_ms`
# no longer constrains this value; before #173 it did. See DEPLOY.md §12.
WatchdogSec=30

User=pi
Group=pi
# The reader needs the I2C bus and (if you wired the status LED) the GPIO lines. Both are group-
# gated on Raspberry Pi OS; `usermod -aG i2c,gpio pi` is what actually grants them, these just make
# the requirement explicit if you run as a different user.
SupplementaryGroups=i2c gpio
WorkingDirectory=/home/pi/Marquee/packages/stylus
ExecStart=/home/pi/Marquee/packages/stylus/.venv/bin/python -m stylus --config /home/pi/Marquee/packages/stylus/config.toml

# stylus-spec §12 "PN532 hangs": the documented recovery is to let the process die and be restarted.
# `always` (not `on-failure`) so a clean exit from an unrecoverable reader state also comes back.
Restart=always
RestartSec=3

# Journald is bounded and rotates; a log file on the SD card grows forever and wears the card out.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stylus

[Install]
WantedBy=multi-user.target
