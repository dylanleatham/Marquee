{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marquee/schemas/album-asset-v1.json",
  "title": "AlbumAsset",
  "description": "Curator's on-disk format: one {curatorId}.json per album. Source of truth for the collection. See curator-spec.md §7 for full field semantics. This schema is a starting point — extend it as the store shape is implemented.",
  "type": "object",
  "required": ["version", "curatorId", "createdAt", "metadata", "roadie"],
  "properties": {
    "version": { "const": 1 },
    "curatorId": { "type": "string", "pattern": "^[a-z0-9]{8}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "required": ["name", "artist", "source"],
      "properties": {
        "name": { "type": "string" },
        "artist": { "type": "string" },
        "year": { "type": "integer" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "source": { "enum": ["spotify", "manual", "discogs"] },
        "spotifyUri": {
          "type": "string",
          "description": "Presence means trusted enough to play. Set three ways (ADR 0059): a Spotify add, an `exact` Discogs→Spotify match, or a human naming the album by hand via PUT /api/albums/:id/spotify-uri. A `close` match never sets it."
        },
        "spotifyArtUrl": { "type": "string" },
        "spotifyMatch": {
          "description": "The Discogs→Spotify match that produced spotifyUri/spotifyArtUrl (ADR 0059). `close` lends its cover only; `exact` also names the album for playback.",
          "type": "object",
          "required": ["confidence", "name", "artist", "matchedAt"],
          "properties": {
            "confidence": { "enum": ["exact", "close"] },
            "name": { "type": "string" },
            "artist": { "type": "string" },
            "year": { "type": "integer" },
            "matchedAt": { "type": "string", "format": "date-time" }
          }
        },
        "discogsReleaseId": { "type": "integer" },
        "discogsUri": { "type": "string" },
        "discogsArtUrl": { "type": "string" }
      }
    },
    "artwork": { "type": "object" },
    "palette": { "type": "object" },
    "pattern": { "type": "object" },
    "patternOverride": {
      "description": "The human's per-album motion override (ADR 0039). Absent or null means the derived `pattern` plays. A streaming value rides beside `pattern`; a CLIP value replaces it in the payload. `pattern` itself is never written by the override.",
      "oneOf": [
        {
          "enum": [
            "static",
            "rotate",
            "pulse",
            "crossfade",
            "aurora",
            "shimmer",
            "wave"
          ]
        },
        { "type": "null" }
      ]
    },
    "patternOverrideParams": {
      "description": "Tuning for `patternOverride` (ADR 0036/0039). Only knobs moved off their spec default are stored; cleared when the override's type changes.",
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "streamingEffect": {
      "description": "Deprecated — ADR 0035's name for `patternOverride`, read (never written) for assets saved before ADR 0039 renamed it.",
      "oneOf": [{ "enum": ["aurora", "shimmer", "wave"] }, { "type": "null" }]
    },
    "streamingParams": {
      "description": "Deprecated — ADR 0036's name for `patternOverrideParams` (ADR 0039).",
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "promptDrafts": { "type": "object" },
    "visualizer": { "type": ["object", "null"] },
    "videoClips": { "type": "array", "items": { "type": "object" } },
    "cardArt": { "type": ["object", "null"] },
    "cardArtCandidates": { "type": "array", "items": { "type": "object" } },
    "tag": { "type": "object" },
    "demoTrack": {
      "description": "The one track a demo tag plays (ADR 0058). Absent/null means a demo scan falls back to the whole album, as a card scan does. Only the choice is stored — the tracklist is fetched on demand.",
      "oneOf": [
        {
          "type": "object",
          "required": ["spotifyUri", "name", "chosenAt"],
          "properties": {
            "spotifyUri": { "type": "string", "pattern": "^spotify:track:" },
            "name": { "type": "string" },
            "trackNumber": { "type": "integer", "minimum": 1 },
            "durationMs": { "type": "integer", "minimum": 0 },
            "chosenAt": { "type": "string", "format": "date-time" }
          }
        },
        { "type": "null" }
      ]
    },
    "verification": { "type": "object" },
    "roadie": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "fetching_metadata",
            "downloading_art",
            "generating_palette",
            "drafting_prompts",
            "awaiting_review",
            "awaiting_video",
            "awaiting_preview",
            "awaiting_tag_write",
            "awaiting_verify",
            "verified",
            "errored",
            "needs_manual"
          ]
        },
        "subState": { "type": ["string", "null"] },
        "flags": { "type": "object" },
        "history": { "type": "array" },
        "lastError": { "type": ["object", "string", "null"] },
        "retryCount": { "type": "integer", "minimum": 0 },
        "syncIssues": { "type": "array" }
      }
    },
    "status": {
      "type": "object",
      "description": "Derived, recomputed on save."
    }
  }
}
