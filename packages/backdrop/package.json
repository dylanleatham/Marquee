    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "fast-check": "^3.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3",
    "ws": "^8.21.3"
  }
}
