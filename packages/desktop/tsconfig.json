{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The Electron main process is CommonJS, unlike the ESM services — override the base's NodeNext.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "test"]
}
