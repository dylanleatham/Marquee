{
  "name": "marquee",
  "version": "0.0.0",
  "private": true,
  "description": "Immersive jukebox — place a record on the stand, the room becomes the record.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "curator": "pnpm --filter @marquee/curator app",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:fast": "turbo run test:unit test:contracts",
    "test:unit": "turbo run test:unit",
    "test:contracts": "turbo run test:contracts",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "type": "turbo run type-check",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review": "node review-agents/orchestrator.mjs",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,css,html}": "prettier --write"
  }
}
