# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ui/
*.tsbuildinfo
packages/contracts/ts/*.d.ts
packages/contracts/py/*_generated.py

# Desktop app packaging output
packages/desktop/staged/
packages/desktop/release/

# Turbo
.turbo/

# Env / secrets
.env
.env.local
*.local.toml
config.toml

# Deploy inventory — hostnames and paths for *your* install. Tracked as hosts.example.json only,
# the same arrangement as the config.example.toml files it sits alongside.
packages/deploy/hosts.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Left behind by the `pip install -e '.[dev]'` the stylus README prescribes.
*.egg-info/

# Test / coverage
coverage/
*.log

# Runtime data stores (these live on-device / on your workstation, not in the code repo)
# NOTE: the *collection* asset store (~/marquee/album-assets) IS git-tracked per the
# runtime overview — but in its OWN repo, not this code repo. Media is never tracked.
marquee-data/
media/
# ...but `media/` above must not swallow SOURCE dirs named media (e.g. curator's ingest code).
!packages/**/src/media/
!packages/**/src/media/**
*.mp4
*.bak

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code worktrees live under .claude/, and .claude/ is now partly tracked (skills, hooks and
# settings — see .claude/README.md). Without this, a stray `git add -A` from the main checkout would
# commit an entire working copy of the repo into itself.
.claude/worktrees/

# Review agent reports are local run artifacts, not source. What survives a run is
# review-agents/ledger.jsonl — triaged verdicts, committed, because a harness that cannot
# remember what its reviewers got right cannot act on dev-harness §12's "delete checks when they
# generate more noise than signal" (docs/specs/harness-self-improvement.md §4.1).
.review-agents/

# Raw samples from scripts/idle-audit.mjs — machine-specific run artifacts. The numbers that matter
# are transcribed into docs/specs/idle-cost-baseline.md, which is where a regression gets noticed.
perf-samples/

# Hue Conductor local data store (holds the bridge application key — a secret)
packages/hue-conductor/data/

# Backdrop local runtime store (library.json + synced visualizer files, populated on-device)
packages/backdrop/data/

# Amp local runtime store (amp.json — the target Sonos room) + synced album-assets
packages/amp/data/
