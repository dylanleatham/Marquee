# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ui/
*.tsbuildinfo
packages/contracts/ts/*.d.ts
packages/contracts/py/*_generated.py

# Desktop app packaging output
packages/desktop/staged/
packages/desktop/release/

# Turbo
.turbo/

# Env / secrets
.env
.env.local
*.local.toml
config.toml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test / coverage
coverage/
*.log

# Runtime data stores (these live on-device / on your workstation, not in the code repo)
# NOTE: the *collection* asset store (~/marquee/album-assets) IS git-tracked per the
# runtime overview — but in its OWN repo, not this code repo. Media is never tracked.
marquee-data/
media/
# ...but `media/` above must not swallow SOURCE dirs named media (e.g. curator's ingest code).
!packages/**/src/media/
!packages/**/src/media/**
*.mp4
*.bak

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Review agent reports are local run artifacts, not source
.review-agents/

# Hue Conductor local data store (holds the bridge application key — a secret)
packages/hue-conductor/data/

# Backdrop local runtime store (library.json + synced visualizer files, populated on-device)
packages/backdrop/data/

# Amp local runtime store (amp.json — the target Sonos room) + synced album-assets
packages/amp/data/
